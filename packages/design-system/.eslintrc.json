{
  "ignorePatterns": ["**/*.mdx"],
  "overrides": [
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          { "devDependencies": true }
        ]
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "src/*",
          "@keplr-wallet/design-system",
          "@keplr-wallet/design-system/*"
        ]
      }
    ]
  }
}
