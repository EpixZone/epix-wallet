    "@types/styled-components": "^5.1.26",
    "storybook": "^8.6.14",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "styled-components": ">=5"
  }
