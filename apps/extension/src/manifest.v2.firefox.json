{
  "applications": {
    "gecko": {
      "id": "wallet@epix.zone",
      "strict_min_version": "89.0"
    }
  },
  "browser_action": {
    "default_area": "navbar"
  },
  "permissions": [
    "storage",
    "notifications",
    "identity",
    "idle",
    "alarms",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "webNavigation",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "proxy"
  ],
  "icons": {
    "16": "assets/icon-beta-16.png",
    "48": "assets/icon-beta-48.png",
    "128": "assets/icon-beta-128.png"
  },
  "web_accessible_resources": [
    "injectedScript.bundle.js",
    "assets/Inter-SemiBold.ttf",
    "assets/icon-128.png",
    "assets/megaphone.svg",
    "assets/locked-logo-128.png",
    "assets/icon-click-cursor.png"
  ]
}
