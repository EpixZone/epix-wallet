{
  "manifest_version": 2,

  "name": "Epix Wallet",
  "description": "Epix Wallet is a browser extension wallet for the EPIX chain and the wider interchain ecosystem.",
  "version": "0.13.40",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Epix Wallet"
  },
  "background": {
    "page": "background.html",
    "persistent": true
  },
  "permissions": [
    "storage",
    "notifications",
    "identity",
    "idle",
    "alarms",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "webNavigation",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.js", "contentScripts.bundle.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "injectedScript.bundle.js",
    "assets/Inter-SemiBold.ttf",
    "assets/icon-128.png",
    "assets/megaphone.svg",
    "assets/locked-logo-128.png",
    "assets/icon-click-cursor.png"
  ]
}
